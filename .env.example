# BusPlus settings. Copy this file to ".env" and fill it in.
# ".env" holds secrets: it is ignored by Git and must never be uploaded to GitHub.
# (On the server, deploy/setup_server.sh creates .env for you with random secrets.)

# "production" on the live server, "development" on your computer.
BUSPLUS_ENV=development

# Long random value that signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Backend (/backend) admin login. Use a long password (10+ characters) in production.
BUSPLUS_ADMIN_USERNAME=admin
BUSPLUS_ADMIN_PASSWORD=

# Create 4 demo drivers (PIN 1234) when the database is first made. Keep "false" in production.
BUSPLUS_DEMO_DRIVERS=false

# Optional ----------------------------------------------------------------
# Database location (default: SQLite file instance/busplus.db)
# DATABASE_URL=sqlite:////opt/busplus/instance/busplus.db
# Number of reverse proxies in front of the app (nginx = 1). Default: 1 in production, 0 otherwise.
# TRUSTED_PROXIES=1
# Redirect http:// to https:// (default: on in production)
# FORCE_HTTPS=true
# Only for "python app.py" on your computer
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=false
