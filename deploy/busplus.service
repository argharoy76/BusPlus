# systemd service: keeps BusPlus running on the server and restarts it if it stops.
# Installed by deploy/setup_server.sh to /etc/systemd/system/busplus.service
#   status:  sudo systemctl status busplus
#   logs:    sudo journalctl -u busplus -f

[Unit]
Description=BusPlus - Khulna University live bus tracker
After=network.target

[Service]
User=busplus
Group=busplus
WorkingDirectory=/opt/busplus
EnvironmentFile=/opt/busplus/.env
ExecStart=/opt/busplus/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3

# Hardening: the app can only write to its own instance/ folder (database).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/busplus/instance
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
